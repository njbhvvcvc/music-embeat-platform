# ============================================
# music-embeat-platform 环境变量配置
# ============================================

# --- 通用 ---
PROJECT_NAME=music-embeat-platform
ENV=production

# --- API 网关 :8080 ---
GATEWAY_PORT=8080
JWT_SECRET=change-me-to-a-random-string
GD_API_BASE=https://music-api.gdstudio.xyz/api.php
GD_API_RATE_LIMIT=50
GD_API_RATE_WINDOW=300

# --- Embeat 推理服务 :7860 ---
EMBEAT_PORT=7860
EMBEAT_MODEL_PATH=/app/checkpoints/EmbeatMLP
EMBEAT_DISABLE_TRACK2VEC=true
EMBEAT_TOP_K=20
EMBEAT_CHANNELS=similar,popular,same_artist,related_artist

# --- Qdrant 向量库 :6333 ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=embeat_45m
QDRANT_MEMORY_LIMIT=4G
QDRANT_WAL_CAPACITY_MB=64

# --- 用户画像服务 :8090 ---
PROFILE_PORT=8090

# --- PostgreSQL ---
POSTGRES_DB=embeat_profile
POSTGRES_USER=embeat
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Cloudflare Tunnel ---
CF_TUNNEL_TOKEN=
CF_TUNNEL_DOMAIN=

# --- Qdrant 向量库导入 (可选) ---
# 如使用预构建 Qdrant 数据库，请从百度网盘下载 (密码: 0616):
# https://pan.baidu.com/s/1CWFzgM75Z4YjP1tZnGCZKg?pwd=0616
# 下载后解压到 deploy/qdrant-data/