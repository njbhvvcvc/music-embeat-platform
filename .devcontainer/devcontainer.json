{
  "name": "music-embeat-platform",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [80, 8080, 7860, 8090, 6333, 5432],
  "portsAttributes": {
    "80": { "label": "前端管理后台" },
    "8080": { "label": "API 网关" },
    "7860": { "label": "Embeat 推理" },
    "8090": { "label": "画像服务" },
    "6333": { "label": "Qdrant 面板" }
  },
  "postCreateCommand": "nohup bash -c 'cd /workspaces/music-embeat-platform && git pull --ff-only 2>&1 | tail -3; until docker info >/dev/null 2>&1; do sleep 2; done; bash deploy/codespaces/deploy.sh' > /workspaces/deploy.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": ["ms-azuretools.vscode-docker"]
    }
  },
  "remoteEnv": {
    "COMPOSE_PROJECT_NAME": "embeat"
  }
}
